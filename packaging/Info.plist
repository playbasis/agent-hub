<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleDevelopmentRegion</key>
  <string>en</string>
  <!--
    Base names must match the ClaudeCodexBridge.app file name, or macOS treats
    the bundle as renamed and ignores the localized name. The product name
    "Playbasis AI Agent Hub" comes from en.lproj/InfoPlist.strings.
  -->
  <key>CFBundleDisplayName</key>
  <string>ClaudeCodexBridge</string>
  <key>CFBundleExecutable</key>
  <string>ClaudeCodexBridgeMenuBar</string>
  <key>CFBundleIconFile</key>
  <string>AppIcon</string>
  <key>CFBundleIdentifier</key>
  <string>dev.claudecodexbridge.app</string>
  <key>CFBundleInfoDictionaryVersion</key>
  <string>6.0</string>
  <key>CFBundleName</key>
  <string>ClaudeCodexBridge</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleShortVersionString</key>
  <string>0.1.0</string>
  <key>CFBundleVersion</key>
  <string>1</string>
  <!--
    The bundle keeps its ClaudeCodexBridge.app path so installed Claude hooks,
    the helper path and Keychain identity stay valid. Finder, Launchpad and
    Spotlight show the localized product name from en.lproj/InfoPlist.strings.
  -->
  <key>LSHasLocalizedDisplayName</key>
  <true/>
  <key>LSMinimumSystemVersion</key>
  <string>13.0</string>
  <!--
    Deliberately NOT LSUIElement. This is a regular desktop application with a
    menu-bar quick-access panel: the Hub must appear in the Dock, Cmd-Tab,
    Launchpad and Spotlight. Closing its main window leaves the runtime and
    status item running; reopening restores the same main window.
  -->
  <key>NSHumanReadableCopyright</key>
  <string>Playbasis</string>
</dict>
</plist>

